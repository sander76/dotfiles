" ---------------------------------------------------------- python ft
augroup vimrc_python
    autocmd!
    " Makegf (goto file) work nicely for Python imports
    autocmd FileType python setlocal path+=**
    autocmd FileType python setlocal commentstring=#\ %s
    autocmd FileType python setlocal foldmethod=indent
    autocmd FileType python setlocal foldlevelstart=99
    " Highlight columns past 88 chars (Black's line length)
    autocmd FileType python setlocal colorcolumn=89
    autocmd FileType python match pythonSpaceError /\s\+$/
augroup END

" Clear search highlighting with <Esc> or leader-h
nnoremap <Esc> :nohlsearch<CR><Esc>
