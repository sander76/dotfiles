" ~/.vim/vimrc -- plugin-free Vim config
" Theme: TokyoNight Night (colors defined inline, no plugin required)
" Language focus: Python

" ------------------------------------------------------------------ basics
set nocompatible
set encoding=utf-8
set number
set relativenumber
set showcmd
set showmode
set laststatus=2
set ruler
set wildmenu
set lazyredraw
set incsearch
set hlsearch
set ignorecase
set smartcase
set backspace=indent,eol,start
set autoindent
set smarttab
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set scrolloff=5
set display+=lastline
set mouse=a

" True color support (guards for older Vims / non-GUI terminals)
if has('termguicolors')
    set termguicolors
endif
set background=dark

" ------------------------------------------------------------ filetypes
filetype on
filetype plugin indent on

" Python syntax highlighting: enable ALL extra groups
" (builtins, exceptions, doctests, space errors, decorators)
let python_highlight_all = 1
let python_highlight_builtins = 1
let python_highlight_exceptions = 1
let python_highlight_doctests = 1
let python_highlight_file_headers_as_comments = 1
" Recognize Python 3 builtins that Vim's default list might miss
let python_slow_sync = 1

syntax enable

" ---------------------------------------------------- TokyoNight Night
" Palette adapted from folke/tokyonight.nvim (variant: night)
