let mapleader = " "
let g:ruff_format_script = $HOME . '/repos/dotfiles/scripts/ruff-format.sh'

map <leader>g <Action>(FindInPath)
map <leader>f <Action>(GotoFile)
map <leader>b <Action>(RecentFiles)
map <leader>ca <Action>(ShowIntentionActions)
map <leader>ck <Action>(ShowHoverInfo)
map <leader>cd <Action>(ShowErrorDescription)

map <C-w>H <Action>(MoveEditorToOppositeTabGroup)
map <C-w>L <Action>(MoveEditorToOppositeTabGroup)
map <C-Tab> <Action>(NextTab)
map <C-S-Tab> <Action>(PreviousTab)

map <c-s> :w<CR>
imap <c-s> <C-o>:w<CR>
map ]d <Action>(GotoNextError)
map [d <Action>(GotoPreviousError)

nnoremap - :NERDTreeFind<CR>
inoremap jj <Esc>

let g:NERDTreeMapActivateNode = '<CR>'
let g:NERDTreeMapOpenSplit = '<Nop>'
let g:NERDTreeMapJumpParent = '<Nop>'
let g:NERDTreeMapQuit = 'q'
let g:NERDTreeMapRename = 'c'
let g:NERDTreeQuitOnOpen = 1

autocmd FileType nerdtree nnoremap <buffer> y <Action>(Copy)
autocmd FileType nerdtree nnoremap <buffer> p <Action>(Paste)
augroup my_group
  autocmd!
  autocmd BufWritePost *.py   !bash ./qa.sh "%" 
augroup END

Plug 'vim-commentary'
Plug 'vim-surround'
Plug 'nerdtree'

set incsearch

set clipboard+=unnamed

set ignorecase
set smartcase

